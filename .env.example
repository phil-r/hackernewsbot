# Required for both server and cron. Relative paths are relative to the project root.
DATABASE_URL=file:./data.sqlite
# Required for cron only.
TELEGRAM_BOT_TOKEN=
# Defaults to @hacker_news_feed. Use @hacker_news_feed_st for development.
TELEGRAM_CHAT_ID=@hacker_news_feed
# Public origin used for short links. Use http://localhost:8080 for development.
BASE_URL=https://readhacker.news
PORT=8080
